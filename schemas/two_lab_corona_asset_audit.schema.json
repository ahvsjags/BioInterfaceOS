{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioif-r2-two-lab-corona-asset-audit-v1.0.0",
  "title": "BioInterfaceOS first-party two-laboratory corona asset audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "evaluated_at", "evidence_class", "allowed_claim_level", "access_scope", "assets", "decision"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_id": {"const": "bioif-r2-two-lab-corona-asset-audit-v1.0.0"},
    "evaluated_at": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "DEVELOPMENT_OBSERVATION"},
    "allowed_claim_level": {"const": "EXPLORATORY"},
    "access_scope": {"type": "object"},
    "assets": {"type": "array", "minItems": 5, "maxItems": 5},
    "decision": {"type": "object"}
  }
}
