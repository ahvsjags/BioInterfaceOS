# Normalize text in the repository for reproducible diffs and checksums.
* text=auto eol=lf

*.md text diff=markdown
*.py text diff=python
*.sh text eol=lf
*.tsv text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Analytical and model formats are binary when intentionally committed.
*.parquet binary
*.duckdb binary
*.db binary
*.sqlite binary
*.gz binary
*.zip binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Byte-verified primary-source metadata must retain its downloaded line endings.
data/raw/r4_candidate_edinburgh_ds7545/README.txt binary

# Derived source-cell ledgers are byte-referenced by their receipts; retain
# the exact CSV bytes emitted by the audit workflow across platforms.
data/raw/r4_candidate_edinburgh_ds7545/derived/*.csv binary
data/raw/r4_candidate_pmc11544298/derived/*.csv binary
